    let cancelled = false;
    setStatus('verifying');
    void verifyStripeCheckoutSession(sessionId)
      .then((res) => {
        if (cancelled) return;
        if (res.verified) {
          setVerifiedPlan(res.plan);
          setVerifiedInterval(res.interval);
          setStatus('paid');
          onVerified(res.user, res.quota);
