# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPTIONAL MULTI-PROVIDER AI KEYS (only activated when configured)
OPENAI_API_KEY=""
MISTRAL_API_KEY=""
ANTHROPIC_API_KEY=""

# APP_URL: Public URL where NOVA AI PRO is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret for signing HTTP-only session cookies.
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# STRIPE INTEGRATION (Optional until payments are enabled in Settings > Secrets)
STRIPE_SECRET_KEY="sk_test_or_live_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly"
STRIPE_PRICE_PRO_ANNUAL="price_pro_annual"
STRIPE_PRICE_BUSINESS_MONTHLY="price_business_monthly"
STRIPE_PRICE_BUSINESS_ANNUAL="price_business_annual"

# OPTIONAL PERSISTENT DATA DIRECTORY (Docker / VPS / Render Disk)
# On Vercel serverless, NOVA AI PRO automatically falls back to /tmp/nova-data.
NOVA_DATA_DIR=""
