# GEMINI_API_KEY: Required for free-tier Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where NOVA AI is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret for signing HTTP-only session cookies.
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# NEON POSTGRESQL (Optional for persistent production/serverless storage — 0 EUR free tier)
# If omitted in local development, NOVA AI uses an in-memory PostgreSQL fallback (0 EUR).
# DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
